# Copy this file to .env and fill in real values. Never commit .env.

POSTGRES_USER=fraudlens_user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraudlens

# If set, DATABASE_URL overrides the POSTGRES_* fields above.
DATABASE_URL=postgresql+psycopg2://fraudlens_user:changeme@localhost:5432/fraudlens

# Used by the Streamlit dashboard to reach the FastAPI backend.
API_BASE_URL=http://localhost:8000
